{
  "name": "aistockvn-mail",
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "typecheck": "tsc -p . && tsc -p tsconfig.worker.json",
    "dev": "vite build && wrangler d1 migrations apply aistockvn-mail --local && wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "vite build && wrangler d1 migrations apply aistockvn-mail --remote && wrangler deploy"
  },
  "type": "module",
  "dependencies": {
    "postal-mime": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "private": true
}
